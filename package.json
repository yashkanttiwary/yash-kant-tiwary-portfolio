{
  "name": "yash-kant-tiwary-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && npm run typecheck",
    "validate": "node scripts/validate-content.mjs",
    "test:browser": "playwright test",
    "test:functional": "playwright test portfolio.spec.ts performance.spec.ts",
    "test:visual": "playwright test visual.spec.ts --project=chromium",
    "test": "npm run validate && npm run lint && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
